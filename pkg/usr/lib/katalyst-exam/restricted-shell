#!/bin/bash
# Restricted interactive shell for the timed coding-challenge round.
# Only `nano` and `python3` are runnable; the candidate works inside
# ~/challenge. This is NOT a hard security boundary -- python3 itself can
# run arbitrary code (os.system, subprocess, sockets). It blocks casually
# running other installed programs; it does not sandbox what a candidate's
# own Python code can do.
set -u

SLEEP_BIN=$(command -v sleep)

BIN_DIR="$HOME/.katalyst-exam/bin"
mkdir -p "$BIN_DIR"
ln -sf "$(command -v nano)" "$BIN_DIR/nano"
ln -sf "$(command -v python3)" "$BIN_DIR/python3"

cd "$HOME/challenge" 2>/dev/null || cd "$HOME"
export PATH="$BIN_DIR"

# Live countdown in the prompt, read from the round_meta file terminal-session
# wrote. Uses bash's builtin $EPOCHSECONDS (no external `date` -- it isn't on
# the restricted PATH anyway). Updates every time a prompt is drawn.
mapfile -t _META < "$HOME/.katalyst-exam/round_meta" 2>/dev/null
ROUND_START="${_META[0]:-$EPOCHSECONDS}"
TIME_LIMIT="${_META[1]:-2700}"
export ROUND_START TIME_LIMIT
export PROMPT_COMMAND='history -a; _r=$(( TIME_LIMIT - (EPOCHSECONDS - ROUND_START) )); (( _r < 0 )) && _r=0; PS1=$(printf "[%02d:%02d left] %s $ " $((_r/60)) $((_r%60)) "$PWD")'

# Command history flushed live (via "history -a" above, each prompt) into
# the hidden append-only log apply pre-created. HISTFILE/HISTCONTROL are
# exported before exec, since rbash blocks changing them afterward -- but
# reading them from the inherited environment at startup is unaffected.
# The file is write-only to this uid (no read bit), so bash silently
# starts with empty in-session history -- that's intended.
export HISTFILE="${HISTORY_LOG:-/var/lib/katalyst-exam/monitor/history.log}"
export HISTTIMEFORMAT='%F %T '
export HISTCONTROL=
export HISTSIZE=100000
export HISTFILESIZE=100000

# Periodic warnings at 10/5/1 min remaining, so a candidate sitting inside
# nano (which doesn't repaint on its own) still gets notified. A terminal
# bell, not printed text -- nano draws straight onto the main screen buffer
# (no alternate-screen like vim/less), so stray printed text would corrupt
# its display until the next redraw. Bells are escalating (1/2/3) so the
# three checkpoints feel distinct. Uses the real `sleep` via its absolute
# path, captured above before PATH was narrowed to nano/python3 only.
(
    for entry in "600:1" "300:2" "60:3"; do
        checkpoint="${entry%%:*}"; bells="${entry##*:}"
        wait_for=$(( ROUND_START + TIME_LIMIT - checkpoint - EPOCHSECONDS ))
        (( wait_for > 0 )) && "$SLEEP_BIN" "$wait_for"
        for ((i = 0; i < bells; i++)); do printf '\a'; "$SLEEP_BIN" 0.3; done
    done
) &
disown

cat <<'EOF'
Katalyst Exam -- coding round

Available commands: nano, python3
Files are in ~/challenge. Write your answer into answer.txt.
Press Ctrl+D or type "exit" when you are done early.

EOF

exec bash --norc --noprofile --restricted
