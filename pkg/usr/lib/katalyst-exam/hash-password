#!/usr/bin/python3 -I
"""Hash an invigilator exit password for /etc/katalyst-exam/exit.hash.

Reads the password from stdin (first line) and prints:
    scrypt$<n>$<r>$<p>$<salt-b64>$<hash-b64>
"""
import base64
import hashlib
import os
import sys

N, R, P, DKLEN = 2 ** 15, 8, 1, 32
MAXMEM = 64 * 1024 * 1024


def make_hash(password: str) -> str:
    salt = os.urandom(16)
    dk = hashlib.scrypt(password.encode(), salt=salt, n=N, r=R, p=P,
                        maxmem=MAXMEM, dklen=DKLEN)
    b64 = lambda b: base64.b64encode(b).decode()
    return f"scrypt${N}${R}${P}${b64(salt)}${b64(dk)}"


def main() -> int:
    password = sys.stdin.readline().rstrip("\n")
    if not password:
        print("error: empty password", file=sys.stderr)
        return 1
    print(make_hash(password))
    return 0


if __name__ == "__main__":
    sys.exit(main())
