#!/usr/bin/python3 -I
"""Full-screen "time's up" screen for a time-boxed coding round.

Shown once the round's time limit is reached. The candidate's submission
has already been snapshotted by terminal-session; there is no way back
into the round from here. Only the invigilator exit password ends the
session (fails closed: wrong password or any error keeps this screen up).
"""
import base64
import hashlib
import hmac
import sys
import time

HASH_FILE = "/etc/katalyst-exam/exit.hash"
MAXMEM = 64 * 1024 * 1024


def verify(password: str) -> bool:
    try:
        with open(HASH_FILE, encoding="ascii") as f:
            scheme, n, r, p, salt, dk = f.read().strip().split("$")
        if scheme != "scrypt":
            return False
        expected = base64.b64decode(dk)
        got = hashlib.scrypt(password.encode(), salt=base64.b64decode(salt),
                             n=int(n), r=int(r), p=int(p), maxmem=MAXMEM,
                             dklen=len(expected))
        return hmac.compare_digest(got, expected)
    except Exception:
        return False


def main() -> int:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    result = {"code": 1}
    state = {"failures": 0}

    css = Gtk.CssProvider()
    css.load_from_data(b"""
        window { background: #1d2430; }
        label { color: #e8ecf2; }
        .brand { font-size: 12pt; font-weight: bold; color: #6f9cff; letter-spacing: 3px; }
        .title { font-size: 28pt; font-weight: bold; }
        .sub { font-size: 15pt; color: #b8c2d0; }
        .small { font-size: 12pt; color: #8f9bad; }
        .error { font-size: 13pt; color: #ff8a80; }
        button.action { background-image: none; background-color: #2f6fdb;
                 border: none; border-radius: 10px; box-shadow: none; }
        button.action label { color: #ffffff; font-size: 16pt; }
        button.action { padding: 12px 28px; }
        button.action:hover { background-color: #3b7cf0; }
        button.action:disabled { background-color: #3a4454; }
        button.action:disabled label { color: #8f9bad; }
        entry { font-size: 15pt; min-width: 320px; padding: 8px;
                background-color: #2a3240; color: #e8ecf2;
                border: 1px solid #4a5568; border-radius: 8px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Gtk.Window(title="Katalyst Exam")
    win.set_decorated(False)
    win.fullscreen()
    win.connect("delete-event", lambda *_: True)  # no dismissing without the password

    def finish(code):
        result["code"] = code
        Gtk.main_quit()

    def label(text, cls):
        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class(cls)
        lbl.set_line_wrap(True)
        lbl.set_justify(Gtk.Justification.CENTER)
        return lbl

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)

    brand = Gtk.Label(label="KATALYST.AI  ·  EXAM")
    brand.get_style_context().add_class("brand")
    box.pack_start(brand, False, False, 0)
    box.pack_start(label("Time's up", "title"), False, False, 0)
    box.pack_start(label("Your submission has been saved. Please wait for the invigilator.",
                         "sub"), False, False, 0)

    box.pack_start(Gtk.Separator(), False, False, 18)
    box.pack_start(label("Invigilator only — enter the exit password to end the session",
                         "small"), False, False, 0)

    row = Gtk.Box(spacing=12)
    row.set_halign(Gtk.Align.CENTER)
    entry = Gtk.Entry()
    entry.set_visibility(False)
    entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    entry.set_placeholder_text("Exit password")
    exit_btn = Gtk.Button(label="End session")
    exit_btn.get_style_context().add_class("action")
    row.pack_start(entry, False, False, 0)
    row.pack_start(exit_btn, False, False, 0)
    box.pack_start(row, False, False, 0)

    status = label("", "error")
    box.pack_start(status, False, False, 0)

    def try_exit(*_):
        if not entry.get_sensitive():
            return
        password = entry.get_text()
        entry.set_text("")
        if password and verify(password):
            finish(0)
            return
        state["failures"] += 1
        delay = min(2 * state["failures"], 30)
        status.set_text(f"Wrong password. Try again in {delay} s.")
        entry.set_sensitive(False)
        exit_btn.set_sensitive(False)

        def unlock():
            entry.set_sensitive(True)
            exit_btn.set_sensitive(True)
            status.set_text("")
            entry.grab_focus()
            return False
        GLib.timeout_add_seconds(delay, unlock)

    entry.connect("activate", try_exit)
    exit_btn.connect("clicked", try_exit)

    win.add(box)
    win.show_all()
    entry.grab_focus()
    Gtk.main()
    return result["code"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # fail closed: keep the screen up
        print(f"time-up error: {exc}", file=sys.stderr)
        time.sleep(2)
        sys.exit(1)
